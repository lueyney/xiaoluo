# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lunjun_app
DB_USER=root
DB_PASSWORD=your_password

# 服务器配置
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://your-domain.com

# JWT配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# 微信小程序配置
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_secret

# 抖音小程序配置
DOUYIN_APP_ID=your_douyin_app_id
DOUYIN_APP_SECRET=your_douyin_app_secret

# 抖音支付配置
DOUYIN_MERCHANT_ID=your_douyin_merchant_id
DOUYIN_PAY_SALT=your_douyin_pay_salt
DOUYIN_PAY_TOKEN=your_douyin_pay_token
DOUYIN_PAY_NOTIFY_URL=https://yaoguang.yaoguangxiaoluo.cn/api/douyin/pay/notify

# 微信支付配置
WECHAT_MCH_ID=your_merchant_id
WECHAT_APIV3_KEY=your_apiv3_key
WECHAT_CERT_SERIAL=your_cert_serial
WECHAT_NOTIFY_URL=https://yaoguang.yaoguangxiaoluo.cn/api/wechat-pay/notify

# 短信服务配置（腾讯云短信）
# 在微信云托管环境变量中也需要配置同名变量
TENCENT_SMS_SECRET_ID=your_tencentcloud_sms_secret_id
TENCENT_SMS_SECRET_KEY=your_tencentcloud_sms_secret_key
TENCENT_SMS_APP_ID=1401053201
TENCENT_SMS_SIGN_NAME=瑶光科技台州
# 登录 / 注册 / 修改密码通用验证码模板ID
TENCENT_SMS_TEMPLATE_ID_LOGIN=2562127

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# PaperFake降重API配置
PAPERFAKE_USERNAME=your_paperfake_username
PAPERFAKE_PASSWORD=your_paperfake_password
PAPERFAKE_API_BASE=https://paperfake.cn/pcserver

# DeepSeek 配置（兼容模板；新项目优先复制 .env.example）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_THINKING=auto

# 降重统一配置：stream、process、fallback、文档降重共用
DEEPSEEK_REWRITE_MODEL=deepseek-v4-pro
DEEPSEEK_REWRITE_TEMPERATURE=0.02
DEEPSEEK_REWRITE_REASONING_EFFORT=low
DEEPSEEK_REWRITE_THINKING=enabled

DEEPSEEK_TEMPERATURE=0.55
DEEPSEEK_MAX_TOKENS=8192
# DeepSeek account capacity may be higher; these application limits preserve
# headroom and keep simultaneous document jobs from overwhelming one process.
DEEPSEEK_GLOBAL_CONCURRENCY=128
DEEPSEEK_REQUEST_TIMEOUT_MS=120000
DEEPSEEK_RETRY_MAX=2
DEEPSEEK_RETRY_BASE_MS=1000
DEEPSEEK_FALLBACK_TIMEOUT_MS=60000
# Optional: use another compatible model for the final non-stream fallback.
DEEPSEEK_FALLBACK_MODEL=
DOCUMENT_REWRITE_MIN_CONCURRENCY=8
DOCUMENT_REWRITE_INITIAL_CONCURRENCY=32
DOCUMENT_REWRITE_CONCURRENCY=128

# DeepSeek + LangGraph.js 学术写作编排
WRITING_MAX_SECTIONS=9
WRITING_MIN_TARGET_WORDS=800
WRITING_MAX_TARGET_WORDS=12000
DEEPSEEK_PLANNING_MODEL=deepseek-chat
DEEPSEEK_DRAFTING_MODEL=deepseek-chat
DEEPSEEK_TITLE_MODEL=deepseek-chat
DEEPSEEK_WORKFLOW_MODEL=deepseek-chat
DEEPSEEK_PLANNING_REASONING_EFFORT=
DEEPSEEK_PLANNING_THINKING=auto
DEEPSEEK_DRAFTING_REASONING_EFFORT=
DEEPSEEK_DRAFTING_THINKING=auto
DEEPSEEK_TITLE_REASONING_EFFORT=
DEEPSEEK_TITLE_THINKING=auto
DEEPSEEK_WORKFLOW_REASONING_EFFORT=
DEEPSEEK_WORKFLOW_THINKING=auto
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_MAX_CONCURRENT_REQUESTS=8
DEEPSEEK_MAX_RETRIES=2

WORKFLOW_RUN_CONCURRENCY=4
WORKFLOW_RUN_MAX_JOBS=1000
WORKFLOW_RUN_JOB_TTL_MS=3600000
