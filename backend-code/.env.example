# ===== 运行环境 =====
NODE_ENV=production
PORT=80
TRUST_PROXY=true
ENABLE_CONSOLE_LOG=true
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
PUBLIC_BASE_URL=https://your-domain.com

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lunjun_app
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_TIMEZONE=+08:00
DB_POOL_SIZE=10

# ===== JWT / 登录 =====
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d
VERIFICATION_MASTER_CODE=

# ===== 日志 =====
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ===== 文件上传（可选） =====
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ===== 微信小程序能力（手机号登录等） =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== 微信支付V3（网页扫码支付） =====
WECHAT_MCH_ID=
WECHAT_APIV3_KEY=
WECHAT_CERT_SERIAL=
WECHAT_NOTIFY_URL=https://your-domain.com/api/wechat-pay/notify

# ===== 腾讯云短信（推荐新命名） =====
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID_LOGIN=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# ===== 腾讯云短信（兼容旧命名，可不填） =====
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID_LOGIN=
SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou

# ===== AI 通用配置 =====
AI_API_TIMEOUT=60000
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1000
ENABLE_REAL_AI_API=true
AI_MOCK_DELAY=3000

# ===== DeepSeek + LangGraph.js 学术写作编排 =====
WRITING_MAX_SECTIONS=9
WRITING_MIN_TARGET_WORDS=800
WRITING_MAX_TARGET_WORDS=12000

# ===== DeepSeek（OpenAI-compatible） =====
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_PLANNING_MODEL=deepseek-chat
DEEPSEEK_DRAFTING_MODEL=deepseek-chat
DEEPSEEK_TITLE_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_MAX_CONCURRENT_REQUESTS=8

# Optional key used by Semantic Scholar academic-search workflow nodes.
# A node-level Key overrides this value. arXiv and Crossref do not require it.
ACADEMIC_SEARCH_API_KEY=
ACADEMIC_SEARCH_TIMEOUT_MS=30000
ACADEMIC_SEARCH_MAX_RESULTS=20
DEEPSEEK_TEMPERATURE=0.55
DEEPSEEK_MAX_RETRIES=2

# ===== Workflow studio async preview =====
WORKFLOW_RUN_CONCURRENCY=4
WORKFLOW_RUN_MAX_JOBS=1000
WORKFLOW_RUN_JOB_TTL_MS=3600000

# ===== 其他 AI Provider（可选，不用可留空） =====
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

QWEN_API_BASE=https://dashscope.aliyuncs.com/api/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo

WENXIN_API_BASE=https://aip.baidubce.com/rpc/2.0/ai_custom/v1
WENXIN_API_KEY=
WENXIN_SECRET_KEY=

HUNYUAN_API_BASE=https://hunyuan.tencentcloudapi.com
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=

SPARK_API_BASE=https://spark-api.xf-yun.com/v1
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=

# ===== 抖音小程序（可选） =====
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
DOUYIN_MERCHANT_ID=
DOUYIN_PAY_SALT=
