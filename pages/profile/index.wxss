.profile-page{min-height:100vh;display:flex;flex-direction:column;padding:32rpx 24rpx 140rpx;background:linear-gradient(180deg,#f0f5ff 0%,#ffffff 40%,#fff7ed 100%);box-sizing:border-box}
.header-card{position:relative;border-radius:48rpx;background:linear-gradient(135deg,#eef2ff 0%,#fdf2ff 70%);padding:48rpx 36rpx;box-shadow:0 28rpx 60rpx rgba(79,70,229,0.18);overflow:hidden;color:#1f2937}
.header-bg{position:absolute;top:-60rpx;right:-40rpx;width:240rpx;height:240rpx;border-radius:50%;background:rgba(255,255,255,0.18)}
.header-content{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center}
.profile-top{display:flex;flex-direction:column;align-items:center;margin-bottom:32rpx}
.avatar-wrapper{width:112rpx;height:112rpx;border-radius:36rpx;background:rgba(255,255,255,0.25);display:flex;align-items:center;justify-content:center;font-size:44rpx;font-weight:700;margin-right:28rpx;box-shadow:0 18rpx 36rpx rgba(0,0,0,0.12)}
.profile-info{display:flex;flex-direction:column}
.profile-name{font-size:40rpx;font-weight:700;margin-bottom:12rpx}
.profile-tags{display:flex;flex-direction:column}
.vip-badge{display:inline-flex;align-items:center;padding:8rpx 20rpx;border-radius:9999rpx;background:rgba(255,255,255,0.25);font-size:24rpx;font-weight:600;margin-bottom:10rpx}
.vip-icon{margin-right:8rpx}
.register-time{font-size:24rpx;color:rgba(255,255,255,0.9)}
.stats-panel{display:flex;justify-content:space-between}
.stat-block{flex:1;text-align:center}
.stat-block:not(:last-child){margin-right:24rpx}
.stat-value{display:block;font-size:44rpx;font-weight:700}
.stat-label{display:block;font-size:24rpx;margin-top:8rpx;color:rgba(255,255,255,0.9)}
.quick-actions{display:flex;margin-top:28rpx}
.action-card{flex:1;background:#ffffff;border-radius:36rpx;padding:32rpx 24rpx;box-shadow:0 20rpx 48rpx rgba(15,23,42,0.12);display:flex;flex-direction:column;align-items:center}
.action-card:not(:last-child){margin-right:20rpx}
.action-icon{width:88rpx;height:88rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx;margin-bottom:16rpx;color:#fff}
.action-icon.balance{background:linear-gradient(135deg,#34d399,#10b981)}
.action-icon.invite{background:linear-gradient(135deg,#f97316,#f59e0b)}
.action-icon.wheel{background:linear-gradient(135deg,#8b5cf6,#6366f1)}
.action-title{font-size:28rpx;font-weight:600;color:#1f2937}
.activity-card{margin-top:28rpx;border-radius:40rpx;background:linear-gradient(135deg,#fff6d1 0%,#ffd6a5 70%);padding:32rpx;box-shadow:0 24rpx 50rpx rgba(249,115,22,0.22);color:#b45309}
.activity-header{display:flex;align-items:center;margin-bottom:28rpx}
.activity-icon{width:72rpx;height:72rpx;border-radius:24rpx;background:#facc15;display:flex;align-items:center;justify-content:center;font-size:36rpx;color:#b45309;margin-right:20rpx}
.activity-texts{display:flex;flex-direction:column}
.activity-title{font-size:32rpx;font-weight:700}
.activity-desc{font-size:24rpx;margin-top:6rpx;color:#b65c10}
.activity-actions{display:flex}
.activity-item{flex:1;border-radius:28rpx;padding:26rpx 24rpx;display:flex;flex-direction:column;box-shadow:0 16rpx 30rpx rgba(180,92,16,0.22)}
.activity-item.active{background:#f59e0b;color:#ffffff;margin-right:20rpx}
.activity-item.disabled{background:rgba(255,255,255,0.6);color:#b45309}
.item-title{font-size:28rpx;font-weight:600;margin-bottom:10rpx}
.item-desc{font-size:24rpx}
.invite-card{margin-top:28rpx;border-radius:44rpx;background:linear-gradient(135deg,#fff1f2 0%,#ffe4e6 70%,#ffd6e8 100%);padding:36rpx;box-shadow:0 24rpx 50rpx rgba(244,114,182,0.22);color:#b91c1c}
.invite-header{display:flex;align-items:center;margin-bottom:28rpx}
.invite-icon{width:76rpx;height:76rpx;border-radius:26rpx;background:#fda4af;display:flex;align-items:center;justify-content:center;font-size:38rpx;color:#b91c1c;margin-right:20rpx}
.invite-info{display:flex;flex-direction:column}
.invite-title{font-size:34rpx;font-weight:700}
.invite-desc{font-size:24rpx;margin-top:8rpx;color:#be123c}
.invite-body{background:rgba(255,255,255,0.7);border-radius:32rpx;padding:28rpx}
.code-box{margin-bottom:24rpx}
.code-label{font-size:24rpx;color:#c026d3}
.code-row{margin-top:12rpx;padding:18rpx 20rpx;border-radius:24rpx;background:rgba(255,255,255,0.9);display:flex;justify-content:space-between;align-items:center}
.code-value{font-size:32rpx;font-weight:700;color:#be123c}
.copy-btn{padding:0 28rpx;height:60rpx;border-radius:24rpx;border:none;background:linear-gradient(135deg,#fb7185,#f472b6);color:#ffffff;font-size:24rpx;font-weight:600}
.invite-stats{display:flex;margin-bottom:28rpx}
.invite-stat{flex:1;text-align:center}
.invite-stat:first-child{margin-right:20rpx}
.invite-number{display:block;font-size:34rpx;font-weight:700;color:#be123c}
.invite-label{display:block;font-size:24rpx;color:#c2410c;margin-top:6rpx}
.invite-btn{width:100%;height:88rpx;border-radius:28rpx;border:none;background:linear-gradient(135deg,#f97316,#ef4444);color:#ffffff;font-size:30rpx;font-weight:700;box-shadow:0 20rpx 40rpx rgba(239,68,68,0.28)}
.feature-card{margin-top:28rpx;border-radius:40rpx;background:#ffffff;padding:28rpx 24rpx;box-shadow:0 20rpx 48rpx rgba(15,23,42,0.1)}
.feature-title{font-size:32rpx;font-weight:700;color:#1f2937;margin-bottom:20rpx}
.feature-item{display:flex;align-items:center;padding:26rpx 0;border-bottom:1rpx solid #f1f5f9}
.feature-item:last-child{border-bottom:none}
.feature-icon{width:72rpx;height:72rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;margin-right:24rpx;font-size:36rpx;color:#ffffff}
.feature-text-wrapper{flex:1;display:flex;align-items:center;gap:12rpx}
.circle.blue{background:linear-gradient(135deg,#6366f1,#4f46e5)}
.circle.orange{background:linear-gradient(135deg,#fb923c,#f97316)}
.circle.green{background:linear-gradient(135deg,#22c55e,#16a34a)}
.circle.purple{background:linear-gradient(135deg,#a855f7,#7c3aed)}
.feature-text{flex:1;font-size:28rpx;color:#1f2937;font-weight:600}
.feature-dot{width:16rpx;height:16rpx;border-radius:9999rpx;background:#ef4444;box-shadow:0 0 0 4rpx rgba(239,68,68,0.2)}
.feature-arrow{font-size:32rpx;color:#cbd5f5}
.logout-card{margin-top:32rpx}
.logout-btn{width:100%;height:92rpx;border-radius:9999rpx;border:none;background:linear-gradient(135deg,#f87171,#fb7185);color:#ffffff;font-size:30rpx;font-weight:700;box-shadow:0 24rpx 48rpx rgba(248,113,113,0.28)}

/* 新增样式 - 居中布局 */
.avatar-circle{width:120rpx;height:120rpx;border-radius:60rpx;box-shadow:0 8rpx 24rpx rgba(99,102,241,0.2);margin-bottom:16rpx}
.profile-name{font-size:36rpx;font-weight:700;margin-bottom:8rpx;color:#1f2937;text-align:center}
.profile-id{font-size:24rpx;opacity:0.6;color:#6b7280}
.stats-row{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:24rpx;padding:0 20rpx}
.stat-item{flex:1;display:flex;flex-direction:column;align-items:center}
.stat-divider{width:1rpx;height:48rpx;background:rgba(99,102,241,0.2)}
.stat-value{font-size:40rpx;font-weight:700;color:#6366f1;margin-bottom:8rpx}
.stat-label{font-size:24rpx;color:#6b7280}

/* 邀请码样式 - Tab版本 */
.invite-section{background:#ffffff;border-radius:36rpx;padding:0;margin-top:28rpx;box-shadow:0 20rpx 48rpx rgba(15,23,42,0.12);overflow:hidden}

.invite-tabs{display:flex;background:#f8fafc}
.invite-tab{flex:1;text-align:center;padding:28rpx;font-size:28rpx;color:#64748b;font-weight:600;transition:all 0.3s}
.invite-tab-active{background:#ffffff;color:#ec4899;position:relative}
.invite-tab-active::after{content:'';position:absolute;bottom:0;left:20%;right:20%;height:4rpx;background:linear-gradient(135deg,#f472b6,#ec4899);border-radius:2rpx}

.tab-content{padding:32rpx}

/* 填写邀请码Tab */
.use-tip-banner{background:linear-gradient(135deg,#fef3c7 0%,#fde68a 100%);border-radius:20rpx;padding:20rpx 24rpx;margin-bottom:24rpx;display:flex;align-items:center;gap:12rpx}
.use-tip-icon{font-size:28rpx}
.use-tip-text{flex:1;font-size:24rpx;color:#92400e;line-height:1.5}
.invite-label{font-size:26rpx;color:#64748b;margin-bottom:12rpx}
.invite-code-input{width:100%;height:96rpx;background:#f8fafc;border:2rpx solid #e5e7eb;border-radius:24rpx;padding:0 24rpx;font-size:32rpx;color:#1f2937;margin-bottom:24rpx}
.submit-code-btn{width:100%;height:88rpx;line-height:88rpx;background:linear-gradient(135deg,#10b981,#059669);color:#ffffff;font-size:28rpx;font-weight:700;border-radius:24rpx;border:none;box-shadow:0 8rpx 16rpx rgba(16,185,129,0.3);margin-bottom:16rpx;display:flex;align-items:center;justify-content:center}
.submit-code-btn::after{border:none}
.submit-code-btn[disabled]{background:#94a3b8;box-shadow:none}
.use-note{display:block;text-align:center;font-size:22rpx;color:#9ca3af}

/* 我的邀请码Tab */
.my-invite-banner{background:linear-gradient(135deg,#fef3c7 0%,#fde68a 100%);border-radius:20rpx;padding:20rpx 24rpx;margin-bottom:24rpx;display:flex;align-items:center;gap:12rpx}
.banner-icon{font-size:28rpx}
.banner-text{flex:1;display:flex;flex-direction:column;gap:4rpx}
.banner-title{font-size:26rpx;font-weight:700;color:#92400e}
.banner-desc{font-size:22rpx;color:#b45309;opacity:0.9}
.code-label-row{margin-bottom:12rpx}
.code-label-text{font-size:26rpx;color:#64748b}
.my-code-display{background:linear-gradient(135deg,#fce7f3 0%,#fbcfe8 100%);border-radius:24rpx;padding:32rpx;margin-bottom:24rpx;text-align:center}
.my-code-text{font-size:48rpx;font-weight:700;color:#ec4899;letter-spacing:8rpx}
.my-stats-grid{display:flex;gap:20rpx;margin-bottom:24rpx}
.stat-card{flex:1;background:#fdf2f8;border-radius:20rpx;padding:20rpx;display:flex;flex-direction:column;align-items:center}
.stat-number{font-size:36rpx;font-weight:700;color:#ec4899;margin-bottom:6rpx}
.stat-text{font-size:22rpx;color:#9ca3af}
.action-buttons{display:flex;gap:16rpx}
.action-btn{flex:1;height:88rpx;line-height:88rpx;border-radius:24rpx;border:none;font-size:26rpx;font-weight:600;box-shadow:0 8rpx 16rpx rgba(0,0,0,0.1);display:flex;align-items:center;justify-content:center;gap:8rpx}
.action-btn::after{border:none}
.copy-btn{background:linear-gradient(135deg,#f472b6,#ec4899);color:#ffffff}
.share-btn{background:linear-gradient(135deg,#0ea5e9,#0284c7);color:#ffffff}
.btn-icon{font-size:28rpx}
