.rewrite-page{min-height:100vh;display:flex;flex-direction:column;background:linear-gradient(180deg,#f5f7ff 0%,#eef5ff 100%);padding-bottom:140rpx}
.info-card{margin:32rpx;padding:32rpx;border-radius:36rpx;background:#ffffff;box-shadow:0 20rpx 40rpx rgba(37,99,235,0.12);display:flex;flex-direction:column}
.info-header{display:flex;justify-content:space-between;align-items:flex-start}
.info-title{display:flex;flex-direction:column}
.info-name{font-size:40rpx;font-weight:700;color:#1f2937;margin-bottom:8rpx}
.info-subtitle{font-size:26rpx;color:#64748b;line-height:1.5}
.info-credits{display:flex;align-items:center;padding:12rpx 20rpx;border-radius:9999rpx;background:rgba(37,99,235,0.08);color:#2563eb;font-weight:600}
.info-credits text{margin-right:6rpx}
.info-credits text:last-child{margin-right:0}
.feature-group{display:flex;margin:0 32rpx 24rpx}
.feature-card{flex:1;padding:28rpx;border-radius:28rpx;background:#ffffff;box-shadow:0 16rpx 32rpx rgba(15,23,42,0.08);display:flex;flex-direction:column;align-items:flex-start;margin-right:20rpx}
.feature-card:last-child{margin-right:0}
.feature-icon{width:72rpx;height:72rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;font-size:36rpx;margin-bottom:16rpx}
.feature-title{font-size:28rpx;font-weight:600;color:#1f2937;margin-bottom:10rpx}
.feature-desc{font-size:24rpx;color:#64748b;line-height:1.5}
.content-scroll{flex:1;min-height:0}
.content-scroll__inner{padding:0 32rpx 40rpx;display:flex;flex-direction:column}
.settings-card{background:#ffffff;border-radius:36rpx;padding:32rpx;box-shadow:0 20rpx 40rpx rgba(15,23,42,0.08);margin-bottom:28rpx}
.input-card{background:#ffffff;border-radius:36rpx;padding:32rpx;box-shadow:0 20rpx 40rpx rgba(15,23,42,0.08);margin-bottom:28rpx}
.tips-card{display:flex;flex-direction:column;gap:14rpx;padding:28rpx;border-radius:34rpx;background:rgba(255,255,255,0.78);box-shadow:0 18rpx 40rpx rgba(15,23,42,0.12);border:1rpx solid rgba(148,163,184,0.18)}
.tips-header{display:flex;align-items:center;margin-bottom:8rpx}
.tips-icon{font-size:32rpx;margin-right:12rpx}
.tips-title{font-size:28rpx;font-weight:700;color:#1f2937}
.tip-item{font-size:24rpx;color:#475569;line-height:1.6}
.section-card{background:#ffffff;border-radius:36rpx;padding:32rpx;box-shadow:0 20rpx 40rpx rgba(15,23,42,0.08);margin-bottom:28rpx}
.settings-header{display:flex;flex-direction:column;margin-bottom:20rpx}
.settings-title{font-size:32rpx;font-weight:700;color:#1f2937;margin-bottom:12rpx}
.settings-caption{font-size:24rpx;color:#64748b}
.setting-list{display:flex;flex-direction:column}
.setting-item{display:flex;flex-direction:column;padding:24rpx;border-radius:28rpx;background:#f8fbff;border:1rpx solid rgba(148,163,184,0.25);margin-bottom:24rpx}
.setting-item:last-child{margin-bottom:0}
.setting-label{display:flex;flex-direction:column;margin-bottom:16rpx}
.setting-label-title{font-size:28rpx;font-weight:600;color:#1f2937;margin-bottom:6rpx}
.setting-hint{font-size:24rpx;color:#94a3b8}
.setting-picker{display:flex;justify-content:space-between;align-items:center;padding:22rpx 26rpx;border-radius:24rpx;background:#ffffff;border:1rpx solid #e2e8f0;font-size:26rpx;color:#334155}
.picker-arrow{font-size:24rpx;color:#94a3b8}
.slider-wrapper{display:flex;flex-direction:column}
.slider-wrapper slider{width:100%;margin-bottom:16rpx}
.slider-level-text{font-size:26rpx;font-weight:600;color:#2563eb;margin-bottom:8rpx}
.slider-level-desc{font-size:24rpx;color:#64748b}
.input-header{display:flex;flex-direction:column;margin-bottom:20rpx}
.input-title{font-size:32rpx;font-weight:700;color:#1f2937;margin-bottom:12rpx}
.input-caption{font-size:24rpx;color:#64748b}
.input-textarea{width:100%;min-height:260rpx;border-radius:28rpx;border:1rpx solid #e2e8f0;background:#f8fafc;padding:28rpx;font-size:28rpx;color:#1f2937;box-sizing:border-box}
.input-footer{display:flex;justify-content:space-between;margin-top:16rpx;font-size:26rpx;color:#64748b}
.action-section{padding:0 8rpx;margin-bottom:28rpx}
.generate-btn{display:inline-flex;align-items:center;justify-content:center;width:100%;height:96rpx;padding:8rpx 12rpx;border-radius:24rpx;color:#fff;font-size:32rpx;font-weight:600;line-height:48rpx;box-shadow:0 16rpx 32rpx rgba(79,70,229,0.22);transition:all .15s;outline:none;border:none;background:linear-gradient(90deg,#2563eb,#9333ea)}
.generate-btn-active{background:linear-gradient(90deg,#2563eb,#9333ea);box-shadow:0 16rpx 32rpx rgba(79,70,229,0.28)}
.generate-btn-disabled{background:linear-gradient(90deg,#9ab9ff,#d5b5ff);pointer-events:none;box-shadow:0 12rpx 24rpx rgba(148,163,184,.2)}
.generate-btn:focus-visible{box-shadow:0 0 0 6rpx rgba(37,99,235,.35)}
.generate-icon{font-size:32rpx;margin-right:12rpx}
.generate-text{flex:1;text-align:center}
.generate-arrow{font-size:32rpx;margin-left:12rpx}
.setting-row{display:flex;justify-content:space-between;align-items:center}
.setting-row .setting-label-title{font-size:28rpx;font-weight:600;color:#1f2937}

/* 降重结果优化样式 */
.result-card{
  background:linear-gradient(180deg,#ffffff 0%,#f8fafc 100%);
  padding:36rpx;
}

.result-header{
  margin-bottom:32rpx;
}

.result-title-group{
  display:flex;
  flex-direction:column;
  gap:20rpx;
}

.result-title{
  font-size:36rpx;
  font-weight:700;
  color:#1f2937;
  display:flex;
  align-items:center;
}

.result-stats{
  display:flex;
  align-items:center;
  gap:16rpx;
  padding:20rpx;
  background:rgba(248,250,252,0.8);
  border-radius:20rpx;
  border:1rpx solid rgba(226,232,240,0.6);
}

.stat-item{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6rpx;
}

.stat-item.highlight{
  padding:0 16rpx;
  background:rgba(37,99,235,0.08);
  border-radius:16rpx;
}

.stat-label{
  font-size:22rpx;
  color:#64748b;
}

.stat-value{
  font-size:28rpx;
  font-weight:700;
  color:#1f2937;
}

.stat-value.similarity{
  color:#2563eb;
  font-size:32rpx;
}

.stat-divider{
  font-size:24rpx;
  color:#cbd5e1;
}

.result-comparison{
  display:flex;
  flex-direction:column;
  gap:24rpx;
  margin-bottom:32rpx;
}

.comparison-item{
  display:flex;
  flex-direction:column;
}

.comparison-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:16rpx;
  padding:0 8rpx;
}

.comparison-title{
  font-size:28rpx;
  font-weight:600;
  color:#475569;
}

.comparison-count{
  font-size:24rpx;
  color:#94a3b8;
  padding:6rpx 14rpx;
  background:rgba(148,163,184,0.1);
  border-radius:12rpx;
}

.comparison-textarea{
  width:100%;
  min-height:300rpx;
  border-radius:20rpx;
  padding:24rpx;
  font-size:26rpx;
  line-height:1.8;
  box-sizing:border-box;
}

.comparison-textarea.original{
  background:rgba(248,250,252,0.6);
  border:1rpx solid rgba(226,232,240,0.6);
  color:#475569;
}

.comparison-textarea.rewritten{
  background:linear-gradient(135deg,rgba(37,99,235,0.03),rgba(147,51,234,0.03));
  border:2rpx solid rgba(37,99,235,0.2);
  color:#1f2937;
  font-weight:500;
}

.comparison-arrow{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12rpx;
  padding:16rpx;
}

.arrow-icon{
  font-size:32rpx;
  color:#2563eb;
}

.arrow-text{
  font-size:24rpx;
  color:#64748b;
  padding:6rpx 16rpx;
  background:rgba(37,99,235,0.08);
  border-radius:12rpx;
  font-weight:600;
}

.result-actions{
  display:flex;
  gap:16rpx;
}

.action-btn{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8rpx;
  height:80rpx;
  border-radius:20rpx;
  font-size:28rpx;
  font-weight:600;
  border:none;
}

.action-btn.primary{
  background:linear-gradient(135deg,#2563eb,#9333ea);
  color:#ffffff;
  box-shadow:0 12rpx 24rpx rgba(37,99,235,0.25);
}

.action-btn.secondary{
  background:#ffffff;
  color:#2563eb;
  border:2rpx solid #2563eb;
  box-shadow:0 8rpx 16rpx rgba(37,99,235,0.12);
}

.btn-icon{
  font-size:28rpx;
}

.btn-text{
  font-size:28rpx;
}