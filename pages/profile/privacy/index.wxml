<view class="privacy-page">
  <view class="hero-card">
    <text class="hero-title">隐私与安全</text>
    <text class="hero-subtitle">我们重视您的数据安全与使用隐私</text>
    <view class="security-status">
      <text class="status-label">安全状态</text>
      <text class="status-value">高</text>
    </view>
  </view>

  <view class="section-card">
    <text class="section-title">权限控制</text>
    <view class="setting-item">
      <view class="setting-texts">
        <text class="setting-name">记录使用历史</text>
        <text class="setting-desc">用于优化体验，可随时关闭</text>
      </view>
      <switch checked="{{permissions.history}}" data-key="history" bindchange="onToggle"></switch>
    </view>
    <view class="setting-item">
      <view class="setting-texts">
        <text class="setting-name">允许位置访问</text>
        <text class="setting-desc">用于个性化推荐和服务</text>
      </view>
      <switch checked="{{permissions.location}}" data-key="location" bindchange="onToggle"></switch>
    </view>
    <view class="setting-item">
      <view class="setting-texts">
        <text class="setting-name">语音输入权限</text>
        <text class="setting-desc">用于语音化输入创作需求</text>
      </view>
      <switch checked="{{permissions.voice}}" data-key="voice" bindchange="onToggle"></switch>
    </view>
  </view>

  <view class="section-card">
    <text class="section-title">数据操作</text>
    <view class="action-row">
      <button class="outline-btn" data-type="download" bindtap="onClickAction">下载数据</button>
      <button class="outline-btn" data-type="delete" bindtap="onClickAction">删除记录</button>
    </view>
    <button class="primary-btn" data-type="contact" bindtap="onClickAction">联系隐私专员</button>
  </view>
</view>

