/* 新增样式 - 优化题目输入区域 */

/* Label和按钮在一行 */
.field-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 小号起名器按钮 */
.title-suggest-btn-sm {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #818cf8 0%, #a78bfa 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 16rpx rgba(129,140,248,0.25);
}

.title-suggest-icon-sm {
  font-size: 28rpx;
}

.title-suggest-text-sm {
  font-size: 24rpx;
}

/* 优化的题目输入框 */
.title-input-full {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  border: 2rpx solid #e0e7ff;
  background: rgba(255,255,255,0.98);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-shadow: 0 4rpx 12rpx rgba(148,163,184,0.08);
  box-sizing: border-box;
}

