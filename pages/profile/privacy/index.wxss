.privacy-page{min-height:100vh;padding:32rpx 24rpx 120rpx;background:linear-gradient(180deg,#eef4ff 0%,#ffffff 60%,#f8fbff 100%);box-sizing:border-box;display:flex;flex-direction:column;gap:28rpx}
.hero-card{background:#ffffff;border-radius:40rpx;padding:32rpx;box-shadow:0 24rpx 56rpx rgba(59,130,246,0.12);display:flex;flex-direction:column;gap:18rpx}
.hero-title{font-size:40rpx;font-weight:700;color:#1f2937;margin-bottom:6rpx}
.hero-subtitle{font-size:26rpx;color:#64748b}
.security-status{margin-top:8rpx;display:flex;align-items:center;gap:12rpx}
.status-label{font-size:24rpx;color:#475569}
.status-value{padding:6rpx 20rpx;border-radius:9999rpx;background:rgba(16,185,129,0.15);color:#0f9d58;font-size:24rpx;font-weight:600}
.section-card{background:#ffffff;border-radius:36rpx;padding:30rpx;box-shadow:0 20rpx 48rpx rgba(15,23,42,0.08);display:flex;flex-direction:column;gap:20rpx}
.section-title{font-size:32rpx;font-weight:700;color:#1f2937}
.setting-item{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:1rpx solid rgba(226,232,240,0.6)}
.setting-item:last-child{border-bottom:none}
.setting-texts{display:flex;flex-direction:column;gap:6rpx}
.setting-name{font-size:28rpx;font-weight:600;color:#1f2937}
.setting-desc{font-size:24rpx;color:#64748b}
.action-row{display:flex;gap:16rpx}
.outline-btn{flex:1;height:72rpx;border-radius:24rpx;border:1rpx solid rgba(79,70,229,0.4);background:rgba(255,255,255,0.6);color:#4f46e5;font-size:26rpx;font-weight:600}
.primary-btn{width:100%;height:82rpx;border-radius:26rpx;border:none;background:linear-gradient(135deg,#2563eb,#7c3aed);color:#ffffff;font-size:28rpx;font-weight:600;box-shadow:0 18rpx 40rpx rgba(79,70,229,0.28)}

