<view class="register-wrapper">
  <scroll-view class="register-scroll" scroll-y="true">
<view class="register-page">
  <view class="register-hero">
        <image class="register-hero__icon" src="/assets/app-logo.png" mode="aspectFill"></image>
    <text class="register-hero__title">创建论文君账号</text>
    <text class="register-hero__subtitle">开启智能创作新体验，即刻拥有学术写作助手</text>
  </view>

  <view tt:if="{{fromInvite}}" class="invite-tip-banner">
    <text class="invite-tip-icon">🎉</text>
    <text class="invite-tip-text">您收到好友的邀请！注册成功后双方各得10积分</text>
  </view>

  <view class="register-card">
    <view class="form-field">
      <view class="form-field__label">手机号</view>
      <view class="form-input">
        <text class="form-input__icon">📱</text>
        <input class="form-input__control" type="number" placeholder="请输入手机号" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
      </view>
    </view>

    <view class="form-field">
      <view class="form-field__label">验证码</view>
      <view class="form-input">
        <text class="form-input__icon">🔢</text>
        <input class="form-input__control" type="number" placeholder="请输入6位验证码" maxlength="6" value="{{code}}" bindinput="onCodeInput" />
        <text class="form-input__suffix form-input__suffix--link" bindtap="sendCode">{{isCodeSent ? countdown + 's' : '获取验证码'}}</text>
      </view>
          <text class="form-hint">收不到验证码？可直接输入万能验证码 {{masterCode}}</text>
    </view>

    <view class="form-field">
      <view class="form-field__label">设置密码</view>
      <view class="form-input">
        <text class="form-input__icon">🔒</text>
        <input class="form-input__control" password="{{!showPassword}}" placeholder="请输入6-20位密码" maxlength="20" value="{{password}}" bindinput="onPasswordInput" />
        <text class="form-input__suffix" bindtap="togglePassword">{{showPassword ? '🙈' : '👁️'}}</text>
      </view>
    </view>

    <view class="form-field">
      <view class="form-field__label">确认密码</view>
      <view class="form-input">
        <text class="form-input__icon">✅</text>
        <input class="form-input__control" password="{{!showConfirmPassword}}" placeholder="请再次输入密码" maxlength="32" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
        <text class="form-input__suffix" bindtap="toggleConfirmPassword">{{showConfirmPassword ? '🙈' : '👁️'}}</text>
      </view>
    </view>

    <view class="form-field">
      <view class="form-field__label">邀请码（选填）</view>
      <view class="form-input">
        <text class="form-input__icon">🎁</text>
        <input class="form-input__control" placeholder="填写邀请码，双方各得10积分" maxlength="20" value="{{inviteCode}}" bindinput="onInviteCodeInput" />
      </view>
    </view>

    <button class="register-btn" loading="{{isLoading}}" disabled="{{isLoading}}" bindtap="submit">{{isLoading ? '注册中...' : '立即注册'}}</button>

    <view class="register-extra">
      <text class="register-extra__text">已有账户？</text>
      <text class="register-extra__link" bindtap="goLogin">返回登录</text>
    </view>
  </view>

  <view class="register-hint">注册即代表同意《用户协议》与《隐私政策》</view>
    </view>
  </scroll-view>
</view>

