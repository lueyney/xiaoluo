@charset "UTF-8";

/* 优化整体风格 - 参考图片 */
.orders-page{min-height:100vh;display:flex;flex-direction:column;background:linear-gradient(180deg,#f5f7ff 0%,#eef4ff 100%);padding-bottom:140rpx}

/* 紧凑顶部 */
.compact-header{margin:24rpx;background:#ffffff;border-radius:24rpx;padding:24rpx;box-shadow:0 8rpx 20rpx rgba(0,0,0,0.08)}
.header-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}
.header-info{flex:1}
.header-label{font-size:24rpx;color:#64748b;margin-bottom:6rpx;display:block}
.header-value-row{display:flex;align-items:baseline}
.header-value{font-size:48rpx;font-weight:700;color:#7c3aed;margin-right:6rpx}
.header-unit{font-size:24rpx;color:#64748b}
.recharge-btn-compact{
  padding:14rpx 28rpx;
  height:60rpx;
  background:linear-gradient(135deg,#7c3aed,#a855f7);
  color:#ffffff;
  font-size:28rpx;
  font-weight:600;
  border-radius:30rpx;
  border:none;
  box-shadow:0 6rpx 16rpx rgba(124,58,237,0.35);
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8rpx;
  line-height:1;
}
.recharge-btn-compact::after{border:none}
.btn-icon{font-size:28rpx;line-height:1}
.quick-stats{display:flex;align-items:center;gap:12rpx;font-size:24rpx;color:#9ca3af;margin-bottom:12rpx}
.quick-stat{color:#64748b}
.stat-dot{color:#cbd5e1}
.first-tip{background:linear-gradient(135deg,#fff7ed 0%,#ffedd5 100%);border:2rpx dashed #fb923c;border-radius:20rpx;padding:16rpx 24rpx;text-align:center;box-shadow:0 4rpx 12rpx rgba(251,146,60,0.15)}
.first-tip-text{font-size:24rpx;color:#ea580c;font-weight:700}
.header-top{display:flex;justify-content:space-between;align-items:center}
.header-left{display:flex;align-items:center;gap:20rpx}
.header-icon{width:72rpx;height:72rpx;border-radius:24rpx;background:rgba(255,255,255,0.22);display:flex;align-items:center;justify-content:center;font-size:32rpx;color:#ffffff}
.header-texts{display:flex;flex-direction:column;gap:6rpx}
.header-title{font-size:34rpx;font-weight:700}
.header-subtitle{font-size:24rpx;opacity:0.88}
.recharge-btn{margin-left:20rpx;padding:0 40rpx;height:64rpx;border:none;border-radius:28rpx;background:linear-gradient(135deg,#34d399,#16a34a);color:#ffffff;font-size:24rpx;font-weight:600;box-shadow:0 16rpx 34rpx rgba(52,211,153,0.26)}
.header-stats{display:flex;background:rgba(255,255,255,0.22);backdrop-filter:blur(18rpx);border-radius:28rpx;padding:18rpx 12rpx;gap:12rpx}
.summary-item{flex:1;text-align:center;color:#ffffff}
.summary-item:not(:last-child){border-right:1rpx solid rgba(255,255,255,0.25)}
.summary-value{display:block;font-size:32rpx;font-weight:700;margin-bottom:4rpx}
.summary-value.highlight{color:#ffffff}
.summary-label{font-size:22rpx;opacity:0.85}
.tab-bar{display:flex;margin:12rpx 24rpx;background:rgba(255,255,255,0.88);border-radius:9999rpx;padding:10rpx;box-shadow:0 14rpx 28rpx rgba(15,23,42,0.08)}
.tab-item{flex:1;height:64rpx;border-radius:9999rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;color:#64748b}
.tab-item.active{background:linear-gradient(135deg,#818cf8,#a78bfa);color:#ffffff;font-weight:600;box-shadow:0 12rpx 24rpx rgba(129,140,248,0.3)}
.order-scroll{flex:1;min-height:0}
.order-scroll__inner{padding:0 24rpx 60rpx;display:flex;flex-direction:column}
.empty-state{margin-top:80rpx;text-align:center;padding:48rpx;border-radius:36rpx;background:rgba(255,255,255,0.92);box-shadow:0 18rpx 40rpx rgba(148,163,184,0.22);color:#475569;display:flex;flex-direction:column;gap:16rpx;align-items:center}
.empty-icon{font-size:72rpx;color:#94a3b8}
.empty-title{font-size:30rpx;font-weight:700;color:#1f2937}
.empty-tip{font-size:24rpx;color:#64748b}
.primary-btn{background:linear-gradient(135deg,#818cf8,#a78bfa,#c084fc);color:#ffffff;border:none;border-radius:28rpx;padding:0 48rpx;height:72rpx;font-size:26rpx;font-weight:600;box-shadow:0 16rpx 32rpx rgba(129,140,248,0.3)}
/* 订单卡片重新设计 - 整齐布局 */
.order-card{
  background:#ffffff;
  border-radius:28rpx;
  padding:28rpx;
  margin-bottom:20rpx;
  box-shadow:0 8rpx 20rpx rgba(148,163,184,0.1);
  border:1rpx solid rgba(226,232,240,0.8);
}

/* 订单头部 - 图标和标题 */
.order-header{
  display:flex;
  align-items:center;
  gap:16rpx;
  margin-bottom:20rpx;
}

.order-icon{
  width:64rpx;
  height:64rpx;
  border-radius:20rpx;
  background:linear-gradient(135deg,rgba(129,140,248,0.15),rgba(167,139,250,0.15));
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:32rpx;
  color:#818cf8;
  flex-shrink:0;
}

.order-title-group{
  flex:1;
  display:flex;
  flex-direction:column;
  gap:12rpx;
}

.order-title{
  font-size:28rpx;
  font-weight:700;
  color:#1f2937;
  line-height:1.5;
}

.order-tags{
  display:flex;
  gap:12rpx;
  flex-wrap:wrap;
}

.order-tag{
  padding:8rpx 16rpx;
  border-radius:16rpx;
  background:#faf8ff;
  color:#6366f1;
  font-size:22rpx;
  font-weight:600;
}

.order-doc-types{
  display:flex;
  align-items:center;
  gap:12rpx;
  margin-bottom:16rpx;
  padding:16rpx;
  background:rgba(248,250,252,0.6);
  border-radius:16rpx;
}

.doc-types-label{
  font-size:24rpx;
  color:#64748b;
  font-weight:600;
  flex-shrink:0;
}

.doc-types-list{
  display:flex;
  gap:8rpx;
  flex-wrap:wrap;
  flex:1;
}

.doc-type-tag{
  padding:6rpx 14rpx;
  border-radius:12rpx;
  font-size:22rpx;
  font-weight:600;
  flex-shrink:0;
}

.order-status{
  padding:8rpx 16rpx;
  border-radius:16rpx;
  font-size:22rpx;
  font-weight:600;
}

/* 订单主体 - 信息列表 */
.order-body{
  margin-bottom:16rpx;
}

.order-info{
  display:flex;
  flex-direction:column;
  gap:16rpx;
}

.info-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:12rpx 0;
}

.info-label{
  font-size:26rpx;
  color:#64748b;
}

.info-value{
  font-size:28rpx;
  font-weight:700;
}

.info-value.credits{
  color:#10b981;
}

.info-value.amount{
  color:#ef4444;
}

/* 订单底部 - 时间信息 */
.order-footer{
  padding-top:16rpx;
  border-top:1rpx solid rgba(226,232,240,0.6);
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20rpx;
  font-size:24rpx;
  color:#94a3b8;
}

.footer-time{
  flex:1;
}

.footer-finish{
  flex-shrink:0;
}
