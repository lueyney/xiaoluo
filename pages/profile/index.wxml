<view class="profile-page">
  <view class="header-card">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="profile-top">
        <image class="avatar-circle" src="/assets/app-logo.png" mode="aspectFill"></image>
        <text class="profile-name">{{userInfo.nickname}}</text>
        <text class="profile-id">更专业的论文范式</text>
      </view>
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value">{{userInfo.credits}}</text>
          <text class="stat-label">积分余额</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{stats.totalOrders}}</text>
          <text class="stat-label">总订单</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{stats.generatedDocs}}</text>
          <text class="stat-label">生成文档</text>
        </view>
      </view>
    </view>
  </view>

  <view class="invite-section">
    <view class="invite-tabs">
      <view class="invite-tab {{inviteTab === 'my' ? 'invite-tab-active' : ''}}" data-tab="my" bindtap="switchInviteTab">
        <text>我的邀请码</text>
      </view>
      <view class="invite-tab {{inviteTab === 'use' ? 'invite-tab-active' : ''}}" data-tab="use" bindtap="switchInviteTab">
        <text>填写邀请码</text>
      </view>
    </view>

    <view wx:if="{{inviteTab === 'use'}}" class="tab-content">
      <view class="use-tip-banner">
        <text class="use-tip-icon">🎁</text>
        <text class="use-tip-text">填写好友邀请码后立得10积分，每个账号仅可填写一次</text>
      </view>
      
      <view class="invite-label">邀请码</view>
      <input 
        class="invite-code-input" 
        placeholder="请输入好友的邀请码" 
        maxlength="20" 
        value="{{inputInviteCode}}" 
        bindinput="onInviteCodeInput" />
      
      <button class="submit-code-btn" loading="{{submittingInvite}}" disabled="{{submittingInvite || userInfo.hasUsedInvite}}" bindtap="submitInviteCode">
        {{userInfo.hasUsedInvite ? '已使用过邀请码' : (submittingInvite ? '提交中...' : '🎁  提交并领取奖励')}}
      </button>
      
      <text class="use-note">每个账户仅可使用一次邀请码</text>
    </view>

    <view wx:else class="tab-content">
      <view class="my-invite-banner">
        <text class="banner-icon">🎁</text>
        <view class="banner-text">
          <text class="banner-title">分享邀请码赚积分</text>
          <text class="banner-desc">好友填写后可得10积分，您可按人领取20积分奖励</text>
        </view>
      </view>
      
      <view class="code-label-row">
        <text class="code-label-text">邀请码</text>
      </view>
      
      <view class="my-code-display">
        <text class="my-code-text">{{userInfo.inviteCode || 'LOADING...'}}</text>
      </view>
      
      <view class="my-stats-grid">
        <view class="stat-card">
          <text class="stat-number">{{inviteStats.invitedCount || 0}}</text>
          <text class="stat-text">已邀请人数</text>
        </view>
        <view class="stat-card">
          <text class="stat-number">{{inviteStats.earnedCredits || 0}}</text>
          <text class="stat-text">获得积分</text>
        </view>
        <view class="stat-card highlight">
          <text class="stat-number">{{inviteStats.claimableCount || 0}}</text>
          <text class="stat-text">待领取奖励</text>
        </view>
      </view>
      
      <view class="action-buttons">
        <button class="action-btn copy-btn" bindtap="copyInviteCode">
          <text class="btn-icon">📋</text>
          <text>复制邀请码</text>
        </button>
        <button class="action-btn share-btn" open-type="share">
          <text class="btn-icon">📤</text>
          <text>分享给好友</text>
        </button>
      </view>
      <button class="claim-btn" bindtap="claimInviteReward" loading="{{claimingInviteReward}}" disabled="{{claimingInviteReward || !(inviteStats.claimableCount > 0)}}">
        {{inviteStats.claimableCount > 0 ? (claimingInviteReward ? '领取中...' : '立即领取邀请奖励') : '暂无可领取奖励'}}
      </button>
    </view>
  </view>

  <view class="feature-card">
    <text class="feature-title">其他功能</text>
    <view class="feature-item" data-key="settings" bindtap="handleFeatureTap">
      <view class="feature-icon circle blue">⚙️</view>
      <text class="feature-text">账号设置</text>
      <text class="feature-arrow">›</text>
    </view>
    <view class="feature-item" data-key="notice" bindtap="handleFeatureTap">
      <view class="feature-icon circle orange">🔔</view>
      <view class="feature-text-wrapper">
        <text class="feature-text">消息通知</text>
        <view wx:if="{{hasUnreadNotification}}" class="feature-dot"></view>
      </view>
      <text class="feature-arrow">›</text>
    </view>
    <view class="feature-item" data-key="privacy" bindtap="handleFeatureTap">
      <view class="feature-icon circle green">🛡️</view>
      <text class="feature-text">隐私安全</text>
      <text class="feature-arrow">›</text>
    </view>
    <view class="feature-item" data-key="help" bindtap="handleFeatureTap">
      <view class="feature-icon circle purple">❓</view>
      <text class="feature-text">帮助中心</text>
      <text class="feature-arrow">›</text>
    </view>
  </view>

  <view class="logout-card">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 手机号一键登录弹窗 -->
  <phone-login-modal show="{{showPhoneLoginModal}}" bind:close="onPhoneLoginClose" bind:success="onPhoneLoginSuccess"></phone-login-modal>
</view>
