.payment-records-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7ff 0%, #eef4ff 100%);
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 头部卡片 */
.header-card {
  background: linear-gradient(135deg, #818cf8, #a78bfa);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(129, 140, 248, 0.3);
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #9ca3af;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  display: block;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
}

/* 订单列表 */
.orders-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.order-status.paid {
  color: #10b981;
}

.order-status.pending {
  color: #f59e0b;
}

.order-status.failed {
  color: #ef4444;
}

.order-id {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 订单内容 */
.order-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.label {
  font-size: 26rpx;
  color: #64748b;
}

.value {
  font-size: 28rpx;
  font-weight: 600;
}

.value.amount {
  color: #ef4444;
}

.value.credits {
  color: #7c3aed;
}

.value.time {
  font-size: 24rpx;
  color: #9ca3af;
  font-weight: 400;
}

/* 订单底部 */
.order-footer {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.complete-btn {
  width: 100%;
  height: 72rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(16, 185, 129, 0.3);
}

.complete-btn::after {
  border: none;
}

.order-tip {
  margin-top: 12rpx;
  text-align: center;
}

.order-tip text {
  font-size: 22rpx;
  color: #9ca3af;
}

