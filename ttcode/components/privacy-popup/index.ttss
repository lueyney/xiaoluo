.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: center;
}

.privacy-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx;
}

.privacy-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 32rpx;
  text-align: center;
}

.privacy-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.link {
  color: #2979ff;
}

.privacy-btns {
  display: flex;
  justify-content: space-between;
}

.btn-refuse {
  width: 240rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 44rpx;
}

.btn-agree {
  width: 240rpx;
  background: #2979ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
}

