@charset "UTF-8";

/* 页面容器 */
.preview-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #faf8ff 0%, #f5f7ff 100%);
  display: flex;
  flex-direction: column;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: #9ca3af;
}

/* 预览容器 */
.preview-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 文档头部 */
.doc-header {
  background: linear-gradient(135deg, #818cf8 0%, #a78bfa 50%, #c084fc 100%);
  padding: 40rpx 32rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(129,140,248,0.3);
}

.doc-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.doc-meta {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  opacity: 0.95;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 24rpx;
}

/* 文档内容 */
.doc-content-scroll {
  flex: 1;
  height: 100%;
}

.doc-content {
  padding: 40rpx 32rpx;
  background: #ffffff;
  margin: 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(148,163,184,0.12);
  min-height: 800rpx;
}

.content-text {
  font-size: 30rpx;
  line-height: 2.2;
  color: #1f2937;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 底部操作栏 */
.doc-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.98);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(226,232,240,0.8);
  box-shadow: 0 -8rpx 24rpx rgba(148,163,184,0.1);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.action-btn--primary {
  background: linear-gradient(135deg, #818cf8 0%, #a78bfa 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(129,140,248,0.3);
}

.action-btn--secondary {
  background: #faf8ff;
  color: #6366f1;
  border: 2rpx solid #e0e7ff;
}

.btn-icon {
  font-size: 32rpx;
}

