@charset "UTF-8";
.register-page{min-height:100vh;padding:80rpx 40rpx 120rpx;display:flex;flex-direction:column;align-items:stretch;gap:48rpx;box-sizing:border-box}
.register-wrapper{height:100vh;width:100%;background:linear-gradient(180deg,#f5f7ff 0%,#eef2ff 45%,#ffffff 100%);box-sizing:border-box}
.register-scroll{height:100%;width:100%;box-sizing:border-box}
.register-hero{display:flex;flex-direction:column;align-items:center;text-align:center;margin-bottom:60rpx;color:#1e293b}
.register-hero__icon{width:160rpx;height:160rpx;margin-bottom:32rpx;border-radius:40rpx;display:block;object-fit:cover;box-shadow:0 16rpx 36rpx rgba(37,99,235,0.18)}
.register-hero__title{font-size:52rpx;font-weight:700;color:#1e40af;margin-bottom:16rpx}
.register-hero__subtitle{font-size:28rpx;color:#475569;line-height:1.6;margin:0 24rpx}
.invite-tip-banner{width:100%;background:linear-gradient(135deg,#fef3c7 0%,#fde68a 100%);border-radius:24rpx;padding:20rpx 28rpx;margin-bottom:32rpx;display:flex;align-items:center;gap:12rpx;box-shadow:0 8rpx 16rpx rgba(251,191,36,0.2)}
.invite-tip-icon{font-size:32rpx}
.invite-tip-text{flex:1;font-size:24rpx;color:#92400e;font-weight:600;line-height:1.5}
.register-card{width:100%;background:#ffffff;border-radius:36rpx;padding:48rpx 40rpx;box-shadow:0 32rpx 80rpx rgba(79,70,229,0.15);display:flex;flex-direction:column;gap:32rpx;box-sizing:border-box}
.form-field{display:flex;flex-direction:column;gap:16rpx}
.form-field__label{font-size:28rpx;color:#334155;font-weight:600}
.form-input{height:96rpx;border-radius:28rpx;border:1rpx solid rgba(148,163,184,0.4);background:#f8fafc;display:flex;align-items:center;padding:0 28rpx;gap:20rpx;box-shadow:inset 0 0 0 1rpx rgba(148,163,184,0.1)}
.form-input__icon{font-size:32rpx;color:#6366f1}
.form-input__control{flex:1;height:100%;font-size:30rpx;color:#1f2937}
.form-input__suffix{font-size:30rpx;color:#94a3b8}
.form-input__suffix--link{color:#2563eb;font-weight:600}
.register-btn{width:100%;height:100rpx;border-radius:32rpx;border:none;background:linear-gradient(135deg,#10b981 0%,#2563eb 100%);color:#ffffff;font-size:32rpx;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 24rpx 48rpx rgba(37,99,235,0.28)}
.register-extra{display:flex;justify-content:center;gap:12rpx;font-size:26rpx;color:#64748b}
.register-extra__link{color:#2563eb;font-weight:600}
.register-hint{margin-top:40rpx;font-size:24rpx;color:#94a3b8;text-align:center}
.form-hint{margin-top:12rpx;font-size:24rpx;color:#64748b;line-height:1.5}

