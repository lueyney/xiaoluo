@charset "UTF-8";

.profile-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(160deg, #eef2ff 0%, #f0f9ff 45%, #f5f3ff 100%);
  padding: 24rpx 28rpx 140rpx;
  box-sizing: border-box;
}

/* ── 头部用户卡片 ── */
.header-card {
  position: relative;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #e8edff 0%, #f3e8ff 100%);
  padding: 48rpx 36rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(79,70,229,.14);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.header-bg {
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.18);
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.profile-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  box-shadow: 0 8rpx 28rpx rgba(99,102,241,.25);
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e1b4b;
  text-align: center;
}

.profile-id {
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0 16rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: rgba(99,102,241,.2);
}

.stat-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #4f46e5;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* ── 邀请码区块 ── */
.invite-section {
  background: rgba(255,255,255,.97);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(100,116,139,.12);
  border: 1rpx solid rgba(226,232,240,.8);
  overflow: hidden;
}

.invite-tabs {
  display: flex;
  background: #f8fafc;
  border-bottom: 1rpx solid #f1f5f9;
}

.invite-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx;
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

.invite-tab-active {
  background: #fff;
  color: #6366f1;
  font-weight: 700;
  position: relative;
}

.invite-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: linear-gradient(135deg, #818cf8, #a78bfa);
  border-radius: 2rpx;
}

.tab-content { padding: 32rpx; }

/* 填写邀请码 */
.use-tip-banner {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.use-tip-icon { font-size: 28rpx; }

.use-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

.invite-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  display: block;
}

.invite-code-input {
  width: 100%;
  height: 88rpx;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2937;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.submit-code-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #6366f1, #a855f7);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 22rpx;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(99,102,241,.3);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-code-btn::after { border: none; }
.submit-code-btn[disabled] { background: #c4b5fd; box-shadow: none; }

.use-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}

/* 我的邀请码 */
.my-invite-banner {
  background: linear-gradient(135deg, #eef2ff, #f3e8ff);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.banner-icon { font-size: 28rpx; }

.banner-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.banner-title { font-size: 26rpx; font-weight: 700; color: #4f46e5; }
.banner-desc  { font-size: 22rpx; color: #7c3aed; opacity: .9; }

.code-label-row { margin-bottom: 12rpx; }
.code-label-text { font-size: 26rpx; color: #64748b; }

.my-code-display {
  background: linear-gradient(135deg, #eef2ff, #f3e8ff);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.my-code-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #4f46e5;
  letter-spacing: 8rpx;
}

.my-stats-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #f5f3ff;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-number { font-size: 36rpx; font-weight: 800; color: #6366f1; }
.stat-text   { font-size: 22rpx; color: #6b7280; }

.action-buttons { display: flex; gap: 16rpx; }

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 22rpx;
  border: none;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.action-btn::after { border: none; }

.copy-btn  { background: linear-gradient(135deg, #6366f1, #a78bfa); color: #fff; box-shadow: 0 10rpx 24rpx rgba(99,102,241,.28); }
.share-btn { background: linear-gradient(135deg, #0ea5e9, #0284c7); color: #fff; box-shadow: 0 10rpx 24rpx rgba(14,165,233,.28); }

.btn-icon { font-size: 28rpx; }

/* ── 功能菜单 ── */
.feature-card {
  background: rgba(255,255,255,.97);
  border-radius: 32rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(100,116,139,.12);
  border: 1rpx solid rgba(226,232,240,.8);
}

.feature-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.feature-item:last-child { border-bottom: none; }

.feature-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 32rpx;
  color: #fff;
  flex-shrink: 0;
}

.circle.blue   { background: linear-gradient(135deg, #6366f1, #4f46e5); }
.circle.orange { background: linear-gradient(135deg, #fb923c, #f97316); }
.circle.green  { background: linear-gradient(135deg, #22c55e, #16a34a); }
.circle.purple { background: linear-gradient(135deg, #a855f7, #7c3aed); }

.feature-text-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.feature-text { flex: 1; font-size: 28rpx; color: #1f2937; font-weight: 600; }

.feature-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 9999rpx;
  background: #ef4444;
  box-shadow: 0 0 0 4rpx rgba(239,68,68,.2);
}

.feature-arrow { font-size: 36rpx; color: #c4b5fd; font-weight: 300; }

/* ── 退出按钮 ── */
.logout-card { margin-top: 8rpx; }

.logout-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 9999rpx;
  border: none;
  background: linear-gradient(135deg, #f87171, #fb7185);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 20rpx 40rpx rgba(248,113,113,.25);
}
.logout-btn::after { border: none; }
