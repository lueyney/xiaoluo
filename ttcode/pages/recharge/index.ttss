/* 充值页面 - 参考图片风格 */
.recharge-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7ff 0%, #eef2ff 50%, #ffffff 100%);
  padding: 24rpx;
  padding-bottom: 120rpx;
  position: relative;
}

/* 右上角按钮 */
.top-right-btn {
  position: fixed;
  top: 24rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #818cf8, #a78bfa);
  color: #ffffff;
  padding: 12rpx 20rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 6rpx 16rpx rgba(129, 140, 248, 0.4);
  z-index: 100;
  font-size: 24rpx;
  font-weight: 600;
}

.top-right-btn .btn-icon {
  font-size: 24rpx;
}

.top-right-btn .btn-text {
  font-size: 24rpx;
}

/* Hero卡片 - 简约清爽 */
.hero-card {
  position: relative;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(251, 191, 36, 0.2);
}

.hero-bg-circle {
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
}

.hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #92400e;
  margin-bottom: 8rpx;
  display: block;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #b45309;
  margin-bottom: 20rpx;
  display: block;
}

.current-balance {
  background: rgba(255, 255, 255, 0.6);
  border-radius: 9999rpx;
  padding: 12rpx 28rpx;
  display: inline-flex;
  align-items: baseline;
  gap: 6rpx;
}

.balance-prefix {
  font-size: 24rpx;
  color: #92400e;
}

.balance-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #fb923c;
}

.balance-suffix {
  font-size: 24rpx;
  color: #92400e;
}

/* 推荐横幅 - 橙粉渐变 */
.recommend-banner {
  background: linear-gradient(135deg, #fb923c 0%, #f472b6 100%);
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 24rpx rgba(251, 146, 60, 0.3);
}

.banner-content {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.banner-icon {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.banner-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.banner-arrow {
  font-size: 32rpx;
  color: #ffffff;
}

.packages-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
  display: block;
}

.section-subtitle {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 24rpx;
  display: block;
}

/* 充值列表 - 单列布局 */
.packages-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.package-item {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid #e5e7eb;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
}

/* 首充特惠样式 */
.package-first-time {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border-color: #fb923c;
  border-width: 3rpx;
  box-shadow: 0 8rpx 20rpx rgba(251, 146, 60, 0.2);
}

.first-badge {
  position: absolute;
  top: -8rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 8rpx rgba(239, 68, 68, 0.4);
}

.icon-orange {
  background: linear-gradient(135deg, #fb923c, #f97316);
}

.icon-purple {
  background: linear-gradient(135deg, #c084fc, #a855f7);
}

.amount-large {
  font-size: 52rpx;
}

.price-large {
  font-size: 40rpx;
}

.bonus-tag {
  display: inline-block;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 9999rpx;
  margin-left: 8rpx;
  font-weight: 700;
}

.package-recommended {
  border-color: #a855f7;
  border-width: 2rpx;
}

.hot-badge {
  position: absolute;
  top: -8rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #a855f7, #7c3aed);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 8rpx rgba(168, 85, 247, 0.3);
}

.package-left {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.package-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #c084fc, #a855f7);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.package-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.package-amount {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1;
}

.package-unit {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.package-desc {
  font-size: 22rpx;
  color: #9ca3af;
}

.package-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.package-price-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #ef4444;
}

.package-rate {
  font-size: 20rpx;
  color: #9ca3af;
}

.package-arrow {
  font-size: 28rpx;
  color: #cbd5e1;
  margin-top: 4rpx;
}

.package-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  border: 2rpx solid #e5e7eb;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  transition: all 0.3s;
}

.package-card-selected {
  border-color: #6366f1;
  background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%);
  box-shadow: 0 16rpx 32rpx rgba(99, 102, 241, 0.2);
  transform: scale(1.05);
}

.package-card-recommended {
  border-color: #f59e0b;
}

.recommended-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 16rpx rgba(245, 158, 11, 0.3);
}

.bonus-badge {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 16rpx rgba(16, 185, 129, 0.3);
}

.package-header {
  width: 100%;
  text-align: center;
}

.package-label {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 600;
}

.package-body {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.package-credits {
  font-size: 56rpx;
  font-weight: 700;
  color: #1f2937;
}

.package-credits-unit {
  font-size: 24rpx;
  color: #9ca3af;
}

.package-bonus {
  width: 100%;
  text-align: center;
}

.bonus-text {
  font-size: 22rpx;
  color: #10b981;
  font-weight: 600;
}

.package-footer {
  width: 100%;
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.package-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
}

/* 为什么选择 */
.why-section {
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.why-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.why-icon {
  font-size: 32rpx;
}

.why-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #166534;
}

.why-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.why-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.check-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.why-text {
  flex: 1;
  font-size: 24rpx;
  color: #166534;
  line-height: 1.5;
}

/* 充值说明 */
.notice-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.notice-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.notice-icon {
  font-size: 28rpx;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

/* 安全提示 */
.secure-tips {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 20rpx;
}

.secure-item {
  font-size: 22rpx;
  color: #10b981;
  font-weight: 600;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.recharge-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 16rpx 32rpx rgba(99, 102, 241, 0.3);
}

.recharge-btn::after {
  border: none;
}

