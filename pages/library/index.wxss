@charset "UTF-8";

/* 页面容器 */
.library-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #faf8ff 0%, #f5f7ff 45%, #ffffff 100%);
  padding-bottom: 120rpx;
}

/* 搜索栏 */
.search-bar-simple {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
}

.search-input {
  flex: 1;
  border: 1rpx solid rgba(148,163,184,0.3);
  border-radius: 28rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(37,99,235,0.12);
}

.filter-trigger {
  min-width: 160rpx;
  height: 72rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #818cf8 0%, #a78bfa 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(129,140,248,0.25);
}

.error-banner {
  margin: 0 28rpx 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(248,113,113,0.15);
  color: #b91c1c;
  font-size: 26rpx;
}

/* 统计卡片 */
.stats-section {
  padding: 0 28rpx 24rpx;
}

.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #818cf8 0%, #a78bfa 50%, #c084fc 100%);
  border-radius: 32rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 20rpx 40rpx rgba(124,58,237,0.25);
  color: #ffffff;
}
/* 统计数据 */
.stats-item {
  flex: 1;
  text-align: center;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.4);
}

.stats-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  opacity: 0.95;
}

/* 文档列表 */
.documents-scroll {
  flex: 1;
  min-height: 0;
}

.documents-scroll__inner {
  padding: 0 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 空状态 */
.empty-state {
  margin-top: 80rpx;
  text-align: center;
  padding: 72rpx 48rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.96);
  box-shadow: 0 24rpx 48rpx rgba(79,70,229,0.15);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
}

.empty-icon {
  font-size: 96rpx;
  color: #c4b5fd;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.empty-tip {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

.primary-btn {
  background: linear-gradient(135deg, #818cf8 0%, #a78bfa 50%, #c084fc 100%);
  color: #fff;
  border-radius: 32rpx;
  padding: 0 72rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 16rpx 32rpx rgba(129,140,248,0.3);
}

/* 文档卡片 */
.doc-card {
  position: relative;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(148,163,184,0.15);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(226,232,240,0.8);
}

.doc-card__badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 12rpx 28rpx;
  border-bottom-left-radius: 24rpx;
  border-top-right-radius: 28rpx;
  background: linear-gradient(135deg, #818cf8 0%, #a78bfa 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 新文档标记 */
.doc-card__new-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(239,68,68,0.35);
  z-index: 2;
  animation: pulse-new 2s ease-in-out infinite;
}

@keyframes pulse-new {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.85;
    transform: scale(1.05);
  }
}

.doc-card__body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.doc-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  padding-right: 120rpx;
}

.doc-card__meta {
  font-size: 24rpx;
  color: #64748b;
}

.doc-card__preview {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.doc-card__footer {
  display: flex;
  gap: 20rpx;
}

.outline-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 24rpx;
  border: 2rpx solid #e0e7ff;
  background: #faf8ff;
  color: #6366f1;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
