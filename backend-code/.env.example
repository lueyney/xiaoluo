# ===== 运行环境 =====
NODE_ENV=production
PORT=80
TRUST_PROXY=true
ENABLE_CONSOLE_LOG=true
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
PUBLIC_BASE_URL=https://your-domain.com

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lunjun_app
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_TIMEZONE=+08:00
DB_POOL_SIZE=10

# ===== JWT / 登录 =====
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=7d
VERIFICATION_MASTER_CODE=

# ===== 日志 =====
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ===== 降重请求审计（生产环境强制不记录正文） =====
REWRITE_AUDIT_LOG=false
REWRITE_AUDIT_LOG_CONTENT=false
REWRITE_AUDIT_RETENTION_DAYS=3
REWRITE_AUDIT_CLEANUP_INTERVAL_HOURS=6
REWRITE_AUDIT_MAX_FILE_BYTES=10485760
REWRITE_AUDIT_MAX_FILES=10

# ===== 文件上传（可选） =====
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ===== 微信小程序能力（手机号登录等） =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== 微信支付V3（网页扫码支付） =====
WECHAT_MCH_ID=
WECHAT_APIV3_KEY=
WECHAT_CERT_SERIAL=
WECHAT_NOTIFY_URL=https://your-domain.com/api/wechat-pay/notify

# ===== 腾讯云短信（推荐新命名） =====
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID_LOGIN=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# ===== 腾讯云短信（兼容旧命名，可不填） =====
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_APP_ID=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID_LOGIN=
SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou

# ===== AI 通用配置 =====
AI_API_TIMEOUT=60000
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1000
ENABLE_REAL_AI_API=true
AI_MOCK_DELAY=3000

# ===== DeepSeek + LangGraph.js 学术写作编排 =====
WRITING_MAX_SECTIONS=9
WRITING_MIN_TARGET_WORDS=800
WRITING_MAX_TARGET_WORDS=12000

# ===== DeepSeek（OpenAI-compatible） =====
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 全局兜底模型。当前兼容网关提供 deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-pro
# 可选兼容网关参数。留空/auto 时不会发送 reasoning_effort 或 thinking
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_THINKING=auto

# 降重统一配置：文本流式、旧 process 接口、fallback 和文档降重均读取这一组
DEEPSEEK_REWRITE_MODEL=deepseek-v4-pro
DEEPSEEK_REWRITE_TEMPERATURE=1
DEEPSEEK_REWRITE_TOP_P=1
REWRITE_BATCH_MODE=sentence
DEEPSEEK_REWRITE_REASONING_EFFORT=low
DEEPSEEK_REWRITE_THINKING=enabled

# 以下旧变量仅保留兼容说明，降重运行时不再读取
# DEEPSEEK_REWRITE_FALLBACK_MODEL=
# DEEPSEEK_DOCUMENT_REWRITE_MODEL=

# 写作工作流模型，与降重业务相互独立
DEEPSEEK_PLANNING_MODEL=deepseek-chat
DEEPSEEK_DRAFTING_MODEL=deepseek-chat
DEEPSEEK_TITLE_MODEL=deepseek-chat
DEEPSEEK_SOCIAL_MODEL=deepseek-v4-pro
DEEPSEEK_WORKFLOW_MODEL=deepseek-chat

# 写作工作流的可选思考配置
DEEPSEEK_PLANNING_REASONING_EFFORT=
DEEPSEEK_PLANNING_THINKING=auto
DEEPSEEK_DRAFTING_REASONING_EFFORT=
DEEPSEEK_DRAFTING_THINKING=auto
DEEPSEEK_TITLE_REASONING_EFFORT=
DEEPSEEK_TITLE_THINKING=auto
DEEPSEEK_SOCIAL_REASONING_EFFORT=
DEEPSEEK_SOCIAL_THINKING=disabled
DEEPSEEK_WORKFLOW_REASONING_EFFORT=
DEEPSEEK_WORKFLOW_THINKING=auto
LOCAL_SOCIAL_TEST_MODE=false
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
DEEPSEEK_MAX_CONCURRENT_REQUESTS=8

# Optional key used by Semantic Scholar academic-search workflow nodes.
# A node-level Key overrides this value. arXiv and Crossref do not require it.
ACADEMIC_SEARCH_API_KEY=
ACADEMIC_SEARCH_TIMEOUT_MS=30000
ACADEMIC_SEARCH_MAX_RESULTS=20
DEEPSEEK_TEMPERATURE=0.55
DEEPSEEK_MAX_RETRIES=2

# ===== Workflow studio async preview =====
WORKFLOW_RUN_CONCURRENCY=4
WORKFLOW_RUN_MAX_JOBS=1000
WORKFLOW_RUN_JOB_TTL_MS=3600000

# ===== 其他 AI Provider（可选，不用可留空） =====
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

QWEN_API_BASE=https://dashscope.aliyuncs.com/api/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-turbo

WENXIN_API_BASE=https://aip.baidubce.com/rpc/2.0/ai_custom/v1
WENXIN_API_KEY=
WENXIN_SECRET_KEY=

HUNYUAN_API_BASE=https://hunyuan.tencentcloudapi.com
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=

SPARK_API_BASE=https://spark-api.xf-yun.com/v1
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=

# ===== 抖音小程序（可选） =====
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
DOUYIN_MERCHANT_ID=
DOUYIN_PAY_SALT=
