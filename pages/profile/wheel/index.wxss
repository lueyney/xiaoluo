.wheel-page{min-height:100vh;padding:32rpx 24rpx 120rpx;background:linear-gradient(180deg,#eef4ff 0%,#ffffff 60%,#f8fbff 100%);box-sizing:border-box;display:flex;flex-direction:column;gap:28rpx}
.hero-card{background:#ffffff;border-radius:40rpx;padding:32rpx;box-shadow:0 24rpx 56rpx rgba(59,130,246,0.12);display:flex;justify-content:space-between;align-items:center}
.hero-left{display:flex;flex-direction:column;gap:6rpx}
.hero-title{font-size:40rpx;font-weight:700;color:#1f2937}
.hero-subtitle{font-size:26rpx;color:#64748b}
.hero-badge{display:flex;flex-direction:column;align-items:center;gap:6rpx;padding:16rpx 24rpx;border-radius:20rpx;min-width:120rpx}
.hero-badge.available{background:linear-gradient(135deg,rgba(124,58,237,0.12),rgba(99,102,241,0.12));border:2rpx solid rgba(124,58,237,0.3)}
.hero-badge.used{background:rgba(148,163,184,0.08);border:2rpx solid rgba(148,163,184,0.2)}
.badge-text{font-size:24rpx;font-weight:600;color:#7c3aed}
.hero-badge.used .badge-text{color:#94a3b8}
.badge-count{font-size:32rpx;font-weight:700;color:#7c3aed}
.hero-badge.used .badge-count{color:#64748b}
.wheel-card{
  background:#ffffff;
  border-radius:44rpx;
  padding:36rpx;
  box-shadow:0 30rpx 60rpx rgba(124,58,237,0.16);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:24rpx;
}

.wheel-container{
  position:relative;
  width:440rpx;
  height:440rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.wheel-board{
  position:relative;
  width:440rpx;
  height:440rpx;
  border-radius:50%;
  background:linear-gradient(135deg,#818cf8,#a78bfa);
  box-shadow:0 20rpx 40rpx rgba(129,140,248,0.3);
  overflow:hidden;
  transition:transform 2.2s cubic-bezier(.25,.1,.25,1);
  border:6rpx solid #ffffff;
}

.wheel-board.spinning{
  transform:rotate(1080deg);
}

.wheel-segment{
  position:absolute;
  top:0;
  left:50%;
  width:220rpx;
  height:220rpx;
  transform-origin:50% 100%;
  display:flex;
  align-items:flex-start;
  justify-content:center;
  padding-top:55rpx;
}

.segment-0{
  transform:translateX(-50%) rotate(0deg);
  background:linear-gradient(180deg,#a78bfa 0%,#818cf8 100%);
  clip-path:polygon(50% 100%, 0% 0%, 100% 0%);
  border-left:1rpx solid rgba(255,255,255,0.3);
  border-right:1rpx solid rgba(255,255,255,0.3);
}

.segment-1{
  transform:translateX(-50%) rotate(60deg);
  background:linear-gradient(180deg,#818cf8 0%,#6366f1 100%);
  clip-path:polygon(50% 100%, 0% 0%, 100% 0%);
  border-left:1rpx solid rgba(255,255,255,0.3);
  border-right:1rpx solid rgba(255,255,255,0.3);
}

.segment-2{
  transform:translateX(-50%) rotate(120deg);
  background:linear-gradient(180deg,#a78bfa 0%,#818cf8 100%);
  clip-path:polygon(50% 100%, 0% 0%, 100% 0%);
  border-left:1rpx solid rgba(255,255,255,0.3);
  border-right:1rpx solid rgba(255,255,255,0.3);
}

.segment-3{
  transform:translateX(-50%) rotate(180deg);
  background:linear-gradient(180deg,#818cf8 0%,#6366f1 100%);
  clip-path:polygon(50% 100%, 0% 0%, 100% 0%);
  border-left:1rpx solid rgba(255,255,255,0.3);
  border-right:1rpx solid rgba(255,255,255,0.3);
}

.segment-4{
  transform:translateX(-50%) rotate(240deg);
  background:linear-gradient(180deg,#a78bfa 0%,#818cf8 100%);
  clip-path:polygon(50% 100%, 0% 0%, 100% 0%);
  border-left:1rpx solid rgba(255,255,255,0.3);
  border-right:1rpx solid rgba(255,255,255,0.3);
}

.segment-5{
  transform:translateX(-50%) rotate(300deg);
  background:linear-gradient(180deg,#818cf8 0%,#6366f1 100%);
  clip-path:polygon(50% 100%, 0% 0%, 100% 0%);
  border-left:1rpx solid rgba(255,255,255,0.3);
  border-right:1rpx solid rgba(255,255,255,0.3);
}

.segment-label{
  font-size:24rpx;
  font-weight:700;
  color:#ffffff;
  text-align:center;
  white-space:nowrap;
  text-shadow:0 2rpx 6rpx rgba(0,0,0,0.25);
  display:inline-block;
  letter-spacing:0.5rpx;
}

/* 每个扇形的文字需要反向旋转以保持水平 */
.segment-0 .segment-label{
  transform:rotate(0deg);
}

.segment-1 .segment-label{
  transform:rotate(-60deg);
}

.segment-2 .segment-label{
  transform:rotate(-120deg);
}

.segment-3 .segment-label{
  transform:rotate(-180deg);
}

.segment-4 .segment-label{
  transform:rotate(-240deg);
}

.segment-5 .segment-label{
  transform:rotate(-300deg);
}

.wheel-pointer{
  position:absolute;
  top:-12rpx;
  left:50%;
  transform:translateX(-50%);
  width:0;
  height:0;
  border-left:18rpx solid transparent;
  border-right:18rpx solid transparent;
  border-top:36rpx solid #ef4444;
  filter:drop-shadow(0 6rpx 16rpx rgba(239,68,68,0.5));
  z-index:10;
}
.wheel-center{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  width:120rpx;
  height:120rpx;
  border-radius:50%;
  background:linear-gradient(135deg,#ffffff 0%,#faf8ff 100%);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  box-shadow:0 12rpx 32rpx rgba(129,140,248,0.3),inset 0 2rpx 8rpx rgba(255,255,255,0.9);
  font-size:24rpx;
  font-weight:700;
  color:#818cf8;
  gap:4rpx;
  border:5rpx solid #ffffff;
  z-index:5;
}

.wheel-center.disabled{
  background:linear-gradient(135deg,#f1f5f9,#e2e8f0);
  color:#94a3b8;
}

.center-icon{
  font-size:36rpx;
}

.center-text{
  text-align:center;
  font-size:20rpx;
  font-weight:600;
}

.wheel-hint{
  font-size:24rpx;
  color:#64748b;
  text-align:center;
  padding:8rpx 20rpx;
  background:rgba(100,116,139,0.08);
  border-radius:16rpx;
}
.result-card{
  background:linear-gradient(135deg,#ffffff 0%,#faf8ff 100%);
  border-radius:36rpx;
  padding:36rpx;
  box-shadow:0 20rpx 48rpx rgba(124,58,237,0.15);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:16rpx;
  border:2rpx solid rgba(124,58,237,0.2);
}

.result-icon-wrapper{
  width:100rpx;
  height:100rpx;
  border-radius:50%;
  background:linear-gradient(135deg,#7c3aed,#6366f1);
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:12rpx;
  box-shadow:0 16rpx 32rpx rgba(124,58,237,0.3);
}

.result-icon{
  font-size:56rpx;
}

.result-title{
  font-size:32rpx;
  font-weight:700;
  color:#1f2937;
}

.result-reward{
  font-size:40rpx;
  font-weight:700;
  color:#7c3aed;
  margin:8rpx 0;
}

.result-desc{
  font-size:26rpx;
  color:#64748b;
  text-align:center;
}

.result-divider{
  width:100%;
  height:1rpx;
  background:rgba(148,163,184,0.2);
  margin:12rpx 0;
}

.result-hint{
  font-size:24rpx;
  color:#10b981;
  padding:8rpx 20rpx;
  background:rgba(16,185,129,0.1);
  border-radius:16rpx;
}
.tips-card{
  background:#ffffff;
  border-radius:32rpx;
  padding:28rpx;
  box-shadow:0 16rpx 36rpx rgba(15,23,42,0.08);
  margin-bottom:28rpx;
}

.tips-header{
  display:flex;
  align-items:center;
  gap:12rpx;
  margin-bottom:20rpx;
}

.tips-icon{
  font-size:32rpx;
}

.tips-title{
  font-size:30rpx;
  font-weight:700;
  color:#1f2937;
}

.tips-content{
  display:flex;
  flex-direction:column;
  gap:14rpx;
}

.tip-item{
  display:flex;
  align-items:flex-start;
  gap:12rpx;
}

.tip-dot{
  font-size:28rpx;
  color:#7c3aed;
  line-height:1.6;
}

.tip-text{
  flex:1;
  font-size:26rpx;
  color:#475569;
  line-height:1.6;
}

.history-card{
  background:#ffffff;
  border-radius:36rpx;
  padding:30rpx;
  box-shadow:0 18rpx 40rpx rgba(15,23,42,0.08);
  display:flex;
  flex-direction:column;
}

.history-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:24rpx;
}

.header-left{
  display:flex;
  align-items:center;
  gap:12rpx;
}

.history-icon{
  font-size:32rpx;
}

.history-title{
  font-size:32rpx;
  font-weight:700;
  color:#1f2937;
}

.history-count{
  font-size:24rpx;
  color:#94a3b8;
  padding:6rpx 16rpx;
  background:rgba(148,163,184,0.08);
  border-radius:16rpx;
}

.history-scroll{
  max-height:400rpx;
}

.history-item{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20rpx;
  margin-bottom:12rpx;
  border-radius:20rpx;
  background:rgba(248,250,252,0.6);
  border:1rpx solid rgba(226,232,240,0.6);
}

.history-left{
  display:flex;
  align-items:center;
  gap:16rpx;
  flex:1;
}

.history-icon-small{
  font-size:32rpx;
  width:48rpx;
  text-align:center;
}

.history-text-group{
  display:flex;
  flex-direction:column;
  gap:6rpx;
}

.history-reward{
  font-size:28rpx;
  color:#1f2937;
  font-weight:600;
}

.history-time{
  font-size:22rpx;
  color:#94a3b8;
}
.outline-btn{padding:0 32rpx;height:60rpx;border-radius:22rpx;border:1rpx solid rgba(124,58,237,0.35);background:rgba(255,255,255,0.7);color:#5b21b6;font-size:24rpx;font-weight:600}
.empty-state{
  text-align:center;
  padding:48rpx 36rpx;
  border:2rpx dashed rgba(148,163,184,0.3);
  border-radius:28rpx;
  background:rgba(248,250,252,0.4);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12rpx;
}

.empty-icon{
  font-size:56rpx;
  margin-bottom:8rpx;
}

.empty-text{
  font-size:28rpx;
  font-weight:600;
  color:#475569;
  display:block;
}

.empty-desc{
  font-size:24rpx;
  color:#94a3b8;
  display:block;
}

