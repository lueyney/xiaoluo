/* 优化的题目输入框 */
.title-input-full {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  border: 2rpx solid #e0e7ff;
  background: rgba(255,255,255,0.98);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2937;
  box-shadow: 0 4rpx 12rpx rgba(148,163,184,0.08);
  box-sizing: border-box;
}

.field-selector-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.3s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.field-selector-container {
  width: 100%;
  height: 80vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.field-selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.field-selector-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.field-selector-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #64748b;
  border-radius: 50%;
  background: #f1f5f9;
}

.field-selector-search {
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.field-search-input {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e0e7ff;
  background: #f8fafc;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.field-search-confirm {
  padding: 0 32rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #818cf8, #a78bfa);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 16rpx rgba(129,140,248,0.3);
}

.field-selector-list {
  flex: 1;
  min-height: 0;
  padding: 0;
}

.field-custom-hint {
  padding: 20rpx 28rpx;
  background: #fef3c7;
  border-left: 4rpx solid #f59e0b;
  margin: 16rpx 28rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hint-icon {
  font-size: 32rpx;
}

.hint-text {
  flex: 1;
  font-size: 26rpx;
  color: #92400e;
  line-height: 1.5;
}

.field-custom-option {
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 100%);
  border-bottom: 1rpx solid #e0e7ff;
}

.custom-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: linear-gradient(135deg, #818cf8, #a78bfa);
  color: #ffffff;
  border-radius: 12rpx;
}

.custom-text {
  flex: 1;
  font-size: 28rpx;
  color: #4f46e5;
  font-weight: 600;
}

.field-option {
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
}

.field-option-text {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.field-option-check {
  font-size: 32rpx;
  color: #818cf8;
  font-weight: 700;
}

.field-empty {
  padding: 80rpx 28rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

